# Content is stored and checked out as LF on every machine, so the bytes a
# reviewer sees are the bytes that were committed. This overrides the local
# core.autocrlf=true, which would otherwise rewrite the working copy per user.
* text=auto eol=lf

# Windows-native scripts are the exception: they need CRLF to run reliably.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Never normalise these. The Maven wrapper uses the only-script distribution,
# so there is no wrapper jar: mvnw fetches Maven itself on first run, and a
# clean checkout still needs nothing but a JDK.
*.jar   binary
*.png   binary
*.ico   binary
*.woff2 binary
